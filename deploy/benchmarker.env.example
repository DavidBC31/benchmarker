# Copie ce fichier en `benchmarker.env` (à la racine du projet) et remplis-le.
# NE PAS versionner benchmarker.env — il contient des secrets.

# Clé API Anthropic (côté serveur uniquement, jamais dans le navigateur).
ANTHROPIC_API_KEY=sk-ant-...

# Mot de passe de l'interface (générer : python -c "import secrets;print(secrets.token_urlsafe(24))").
BENCHMARKER_AUTH_TOKEN=change-moi

# Clé de signature des sessions (générer de la même façon). Stable = sessions persistantes.
BENCHMARKER_SECRET_KEY=change-moi-aussi

# Écoute locale : le tunnel Cloudflare s'y connecte. Laisser sur 127.0.0.1.
BENCHMARKER_HOST=127.0.0.1
BENCHMARKER_PORT=8080

# Stratégie d'extraction par défaut : web_fetch | playwright | auto
BENCHMARKER_FETCH_STRATEGY=auto
